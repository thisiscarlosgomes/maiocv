  "elevation": {
    "--elev-1": "0 5px 30px #17213c12",
    "--elev-2": "0 12px 35px #17181708",
    "--elev-3": "0 25px 50px #08155633"
  },
  "motion": {
    "--dur-fast": "0.2s",
    "--dur-base": "0.4s"
  },
  "space": {
    "--space-4": "4px",
    "--space-8": "8px",
    "--space-12": "12px",
    "--space-16": "16px",
    "--space-20": "20px",
    "--space-24": "24px",
    "--space-32": "32px",
    "--space-40": "40px",
    "--space-48": "48px",
    "--space-64": "64px",
    "--space-88": "88px",
    "--space-120": "120px"
  },
  "dark": {
    "color-scheme": "dark"
  }
}
