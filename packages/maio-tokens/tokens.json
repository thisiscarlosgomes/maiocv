{
  "color": {
    "--maio-ink": "#171817",
    "--maio-muted": "#71736f",
    "--maio-paper": "#fbfbf8",
    "--maio-line": "#e6e7e1",
    "--maio-blue": "#243fb8",
    "--maio-lime": "#dff58a",
    "--maio-focus": "#4969f2",
    "--maio-focus-on-blue": "#dff58a",
    "--maio-surface-data": "#f2f5ec",
    "--maio-border-data": "#dce2d3",
    "--maio-text-data": "#52614b",
    "--maio-chip-bg": "#f1f5eb",
    "--maio-chip-fg": "#637554",
    "--maio-estimate-bg": "#e8eddf",
    "--maio-estimate-fg": "#606f4d",
    "--maio-error": "#9d4c36"
  },
  "alias": {
    "--ink": "var(--maio-ink)",
    "--muted": "var(--maio-muted)",
    "--paper": "var(--maio-paper)",
    "--line": "var(--maio-line)",
    "--blue": "var(--maio-blue)",
    "--lime": "var(--maio-lime)",
    "--background": "var(--maio-paper)",
    "--foreground": "var(--maio-ink)",
    "--primary": "var(--maio-blue)",
    "--muted-foreground": "var(--maio-muted)",
    "--border": "var(--maio-line)",
    "--radius": "var(--radius-card)",
    "--page-title-size": "var(--fs-title)"
  },
  "type": {
    "--font-sans": "var(--font-pp), system-ui, Arial, sans-serif",
    "--fs-display": "clamp(48px, 6.8vw, 92px)",
    "--fs-title": "clamp(36px, 9.2vw, 64px)",
    "--fs-title-from-701": "clamp(44px, 5.2vw, 72px)",
    "--fs-lead": "19px",
    "--fs-body": "16px",
    "--fs-small": "14px",
    "--fs-label": "12px",
    "--tracking-display": "-0.025em",
    "--tracking-body": "0.01em",
    "--tracking-label": "0.08em"
  },
  "layout": {
    "--container": "1280px",
    "--gutter": "22px",
    "--gutter-from-701": "32px",
    "--gutter-from-1051": "48px",
    "--header-h": "78px",
    "--header-h-from-701": "92px"
  },
  "radius": {
    "--radius-chip": "5px",
    "--radius-card": "18px",
    "--radius-input": "40px",
    "--radius-pill": "100px"
